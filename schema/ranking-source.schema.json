{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wpgaurav/blog-rankings/schema/ranking-source.schema.json",
  "title": "Gatilab Blog Rankings source",
  "type": "object",
  "required": ["schema_version", "edition", "published_at", "status", "category", "track", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "edition": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "published_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["beta", "final"]},
    "category": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "track": {"enum": ["independent", "publisher_company"]},
    "entries": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "entry": {
      "type": "object",
      "required": ["id", "name", "canonical_url", "country", "best_for", "reason", "limitation", "confidence", "reviewed_at", "evidence_urls", "scores"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 2, "maxLength": 120},
        "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "best_for": {"type": "string", "minLength": 8, "maxLength": 120},
        "reason": {"type": "string", "minLength": 24, "maxLength": 280},
        "limitation": {"type": "string", "minLength": 12, "maxLength": 240},
        "confidence": {"enum": ["high", "standard", "provisional"]},
        "reviewed_at": {"type": "string", "format": "date"},
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "format": "uri", "pattern": "^https://"},
          "uniqueItems": true
        },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["editorial_quality", "trust", "reach", "freshness", "ux", "impact"],
          "properties": {
            "editorial_quality": {"$ref": "#/$defs/score"},
            "trust": {"$ref": "#/$defs/score"},
            "reach": {"$ref": "#/$defs/score"},
            "freshness": {"$ref": "#/$defs/score"},
            "ux": {"$ref": "#/$defs/score"},
            "impact": {"$ref": "#/$defs/score"}
          }
        }
      }
    }
  }
}
